<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity9">

    <!-- Header met menuknop -->
    <ImageView
        android:id="@+id/btnBackCheckout"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icons8_menu_96"
        app:tint="#06C167" />

    <TextView
        android:id="@+id/tvCheckoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Bezorggegevens"
        android:textColor="#212529"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackCheckout"
        app:layout_constraintStart_toEndOf="@+id/btnBackCheckout"
        app:layout_constraintTop_toTopOf="@+id/btnBackCheckout" />

    <!-- Invoerformulier -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavDivider9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBackCheckout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">



            <!-- Straat en Huisnummer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Straatnaam en huisnummer"
                android:textColor="#212529"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Bijv. Hoofdstraat 12"
                android:inputType="textPostalAddress"
                android:paddingHorizontal="12dp"
                android:textColor="#212529"
                android:textSize="14sp" />

            <!-- Stad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Plaats"
                android:textColor="#212529"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Bijv. Emmen"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#212529"
                android:textSize="14sp" />

            <!-- Telefoonnummer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Telefoonnummer"
                android:textColor="#212529"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Bijv. 0612345678"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="#212529"
                android:textSize="14sp" />

            <!-- Doorgaan Knop (Naar MainActivity10 straks) -->
            <Button
                android:id="@+id/btnProceedToNext"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#06C167"
                android:text="Verder naar betaling"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Donkere achtergrondlaag voor het zijmenu -->
    <View
        android:id="@+id/viewOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:elevation="8dp"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Uitschuifbaar Zijmenu -->
    <LinearLayout
        android:id="@+id/layoutSideMenu"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="vertical"
        android:translationX="-300dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#06C167"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bober Eats"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Menu Opties"
                android:textColor="#E9ECEF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Inloggen"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F3F5" />

        <TextView
            android:id="@+id/menuAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Account aanmaken"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F3F5" />

        <TextView
            android:id="@+id/menuBoberPas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Bober pas"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F3F5" />

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:text="Uitloggen"
            android:textColor="#DC3545"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vaste Navigatiebalk onderaan -->
    <View
        android:id="@+id/bottomNavBg9"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/bottomNavDivider9"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E9ECEF"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBg9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/btnNavHome9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/bottomNavBg9"
        app:layout_constraintEnd_toStartOf="@+id/btnNavSearch9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomNavBg9">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Home"
            app:srcCompat="@drawable/schermafbeelding_2026_09_29_114113"
            app:tint="#212529" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Home"
            android:textColor="#212529"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavSearch9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/bottomNavBg9"
        app:layout_constraintEnd_toStartOf="@+id/btnNavCart9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnNavHome9"
        app:layout_constraintTop_toTopOf="@+id/bottomNavBg9">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Search"
            app:srcCompat="@drawable/icons8_search_50"
            app:tint="#212529" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Search"
            android:textColor="#212529"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavCart9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/bottomNavBg9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnNavSearch9"
        app:layout_constraintTop_toTopOf="@+id/bottomNavBg9">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Cart"
            app:srcCompat="@drawable/icons8_cart_48"
            app:tint="#212529" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cart"
            android:textColor="#212529"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>